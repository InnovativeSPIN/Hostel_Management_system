NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=hostel_erp

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

# Background jobs (SLA escalation, overdue leave, fee alerts, attendance exceptions)
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=10
